{
  "name": "@pulsepond/typescript-sdk",
  "version": "0.2.0",
  "description": "Privacy-conscious browser and server TypeScript SDK for Pulsepond",
  "license": "Apache-2.0",
  "keywords": [
    "analytics",
    "browser",
    "cloudflare",
    "events",
    "node",
    "pulsepond",
    "server",
    "typescript"
  ],
  "homepage": "https://pulsepond.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pulsepond/typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Pulsepond/typescript-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "node --import tsx --test test/browser.e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ajv": "8.20.0",
    "playwright-core": "1.61.1",
    "tsx": "4.23.8",
    "typescript": "7.0.2"
  }
}
